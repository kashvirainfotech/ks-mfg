# KS-MFG ERP Frontend Environment Variables

# Backend API base URL (must include /api/v1 suffix)
# For local development (leave empty or use /api/v1 to use Vite's dev proxy):
VITE_API_BASE_URL=/api/v1

# For Render.com / Production (set in Render Static Site Environment Variables):
# VITE_API_BASE_URL=https://ks-mfg-api.onrender.com/api/v1
